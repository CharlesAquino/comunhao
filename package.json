{
  "name": "oracao-app",
  "private": true,
  "version": "1.4.0-dev.66",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "preview": "vite preview",
    "cap:sync": "npx cap sync",
    "cap:add:android": "npx cap add android",
    "cap:open:android": "npx cap open android",
    "build:mobile": "vite build && npx cap sync",
    "assets:android": "capacitor-assets generate --android",
    "android:debug": "cd android && ./gradlew assembleDebug",
    "android:release": "cd android && ./gradlew assembleRelease",
    "update:manifest": "node scripts/generate-update-manifest.mjs",
    "doctor": "node scripts/doctor/index.mjs",
    "comunhao:doctor": "node scripts/doctor/index.mjs",
    "validate:rc": "bash scripts/validar-release-rc.sh",
    "release:testing": "bash scripts/gerar-release-testing.sh",
    "build:testing": "vite build --mode testing && npx cap sync android",
    "publish:testing": "node scripts/publicar-release-testing.mjs",
    "dev:mural": "vite --mode development",
    "build:development": "vite build --mode development && npx cap sync android",
    "build:web:provisional": "bash scripts/gerar-web-provisoria.sh",
    "android:dev": "npm run build:development && cd android && ./gradlew assembleDebug",
    "validate:development": "bash scripts/validar-mural-development.sh",
    "apk:development": "bash scripts/gerar-apk-development.sh"
  },
  "dependencies": {
    "@capacitor/camera": "^8.2.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@supabase/supabase-js": "^2.110.2",
    "@types/qrcode": "^1.5.6",
    "livekit-client": "^2.20.1",
    "lucide-react": "^1.24.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "three": "^0.180.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/android": "^8.4.2",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.5.2",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.17",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
