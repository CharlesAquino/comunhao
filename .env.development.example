# Copie apenas as chaves públicas do ambiente de desenvolvimento/staging.
# Nunca coloque service-role em variável VITE_.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_APP_CHANNEL=development
# Schema confirmado no projeto development vinculado em 01/08/2026.
VITE_MURAL_SOCIAL_SCHEMA=true
# O schema do Comunhão Estudos só pode ser ativado após migration e preflight remoto.
VITE_ESTUDOS_SCHEMA_ENABLED=false
VITE_ESTUDOS_CATALOG_SCHEMA_ENABLED=false
# Ative somente quando google-services.json estiver configurado no APK DEV.
VITE_ENABLE_NATIVE_PUSH=false
# Endpoint público WebSocket do projeto LiveKit (não é segredo).
VITE_LIVEKIT_URL=wss://seu-projeto.livekit.cloud
